# ========================================================
# DP QUEST — PRODUCTION & LOCAL ENVIRONMENT CONFIGURATION
# ========================================================

# --------------------------------------------------------
# 1. SERVER-SIDE ONLY SECRETS (NEVER EXPOSE IN CLIENT CODE)
# In Vercel: Set in Project Settings -> Environment Variables
# --------------------------------------------------------

# Google Gemini API Key for Server-Side Vision Verification
# AI Studio automatically injects this in development; on Vercel add your Gemini key.
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"

# Optional server-side aliases for Supabase
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"

# --------------------------------------------------------
# 2. CLIENT-SIDE PUBLIC VARIABLES (Exposed to browser via Vite)
# In Vercel: Set in Project Settings -> Environment Variables
# --------------------------------------------------------

# Supabase Project Credentials (Anon key has RLS protection enabled)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"

# --------------------------------------------------------
# 3. LOCAL / DOCKER DEVELOPMENT RUNTIME (Optional)
# --------------------------------------------------------
PORT=3000
